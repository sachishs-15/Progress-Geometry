#!/bin/bash
#PBS -N goalstep_dense_dinov2
#PBS -l select=1:ncpus=32:mem=64gb:ngpus=4
#PBS -l walltime=12:00:00
#PBS -o /home/sachish/proc-planning/experiments/oad_goalstep/pbslogs/
#PBS -e /home/sachish/proc-planning/experiments/oad_goalstep/pbslogs/

for i in $(seq 1 300); do ls /mnt/rdata7 >/dev/null 2>&1 && break; sleep 2; done

D=/mnt/rdata7/proprogress/data/ego4dgoal
PY=/home/sachish/lstr-venv/bin/python
cd /home/sachish/proc-planning/experiments/oad_goalstep

$PY build_targets.py --out $D/oad
ln -sfn $D/precomputed_features/dinov2_dense $D/oad/dinov2_cls

for i in $(seq 0 31); do
  CUDA_VISIBLE_DEVICES=$((i % 4)) OMP_NUM_THREADS=1 $PY -u extract_features.py \
    --out $D/precomputed_features/dinov2_dense --data-info $D/oad/data_info.json \
    --shard-id $i --num-shards 32 --batch 64 > pbslogs/extract_$i.log 2>&1 &
done
wait

$PY check_features.py --root $D/oad --features $D/precomputed_features/dinov2_dense
