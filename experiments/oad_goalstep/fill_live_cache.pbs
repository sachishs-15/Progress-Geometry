#!/bin/bash
#PBS -N goalstep_live_cache
#PBS -l select=1:ncpus=32:mem=128gb:ngpus=4
#PBS -l walltime=12:00:00
#PBS -o /home/sachish/proc-planning/experiments/oad_goalstep/pbslogs/
#PBS -e /home/sachish/proc-planning/experiments/oad_goalstep/pbslogs/

for i in $(seq 1 300); do ls /mnt/rdata7 >/dev/null 2>&1 && break; sleep 2; done

D=/mnt/rdata7/proprogress/data/ego4dgoal
PY=/home/sachish/lstr-venv/bin/python
cd /home/sachish/proc-planning/experiments/oad_goalstep

for i in $(seq 0 31); do
  ( CUDA_VISIBLE_DEVICES=$((i % 4)) OMP_NUM_THREADS=1 $PY -u fill_live_cache.py \
      --cache-dir $D/live_cache/dinov2_noreg_s16 --data-info $D/oad/data_info.json \
      --shard-id $i --num-shards 32 --batch 16 > pbslogs/fill_$i.log 2>&1
    echo "shard $i exit $?" >> pbslogs/fill_exit.log ) &
done
wait

$PY link_live_cache.py --cache-dir $D/live_cache/dinov2_noreg_s16 --data-info $D/oad/data_info.json --root $D/oad
