#!/bin/bash
#PBS -N pouring_eval_w0
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1
#PBS -l walltime=03:00:00
#PBS -o /home/sachish/proc-planning/experiments/pouring_ope/pbslogs/
#PBS -e /home/sachish/proc-planning/experiments/pouring_ope/pbslogs/

PY=/home/sachish/.conda/envs/frozen-encoders/bin/python
C=/home/sachish/proc-planning/experiments/predictive_world_model/checkpoints/pwm_pouring_patch_channel_paper_window0_vicreg_bs4/last.ckpt
cd /home/sachish/proc-planning/experiments/pouring_ope
A="--encoder hubdinov2_vits14 --image-size 196 --stride 1 --checkpoint $C"

for pool in mean flatten agg; do
  $PY run_ope.py $A --ckpt-pool $pool --out-dir results_allframes_prepool --name pouring_w0_vicreg_bs4__$pool
  $PY run_ope.py $A --ckpt-pool $pool --n-frames 32 --out-dir results_fixed32_prepool --name pouring_w0_vicreg_bs4__$pool
done
$PY -u straightness.py --raw-pools --checkpoints pouring_w0_bs4=$C --out-dir results_straightness_w0
